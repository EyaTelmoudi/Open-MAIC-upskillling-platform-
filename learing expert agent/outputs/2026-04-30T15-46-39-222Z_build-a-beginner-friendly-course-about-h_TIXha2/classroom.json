            },
            {
              "id": "text_n4okCkXv",
              "type": "text",
              "left": 60,
              "top": 150,
              "width": 880,
              "height": 103,
              "content": "<p style=\"font-size:18px;\">• HTML = HyperText Markup Language – backbone of web pages</p><p style=\"font-size:18px;\">• Every page starts with &lt;!DOCTYPE html&gt; and includes &lt;html&gt;, &lt;head&gt;, &lt;title&gt;, &lt;body&gt; elements</p><p style=\"font-size:18px;\">• All tags are written with angle brackets &lt; &gt;</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333",
              "rotate": 0
            },
            {
              "id": "chart_1GZm7t9t",
              "type": "chart",
              "left": 250,
              "top": 270,
              "width": 500,
              "height": 250,
              "chartType": "column",
              "data": {
                "labels": [
                  "HTML Document"
                ],
                "legends": [
                  "Structure"
                ],
                "series": [
                  [
                    3
                  ]
                ]
              },
              "themeColors": [
                "#5b9bd5"
              ],
              "rotate": 0
            }
          ],
          "background": {
            "type": "solid",
            "color": "#ffffff"
          }
        }
      },
      "actions": [
        {
          "id": "action_64ZlA7n_",
          "type": "spotlight",
          "elementId": "text_vdSKjzZB"
        },
        {
          "id": "action_9C74Qtq4",
          "type": "speech",
          "text": "Alright, let’s dive into HTML Basics and the structure of a web page."
        },
        {
          "id": "action_CxvLghW3",
          "type": "spotlight",
          "elementId": "text_n4okCkXv"
        },
        {
          "id": "action_FRf76GaN",
          "type": "speech",
          "text": "First, HTML stands for HyperText Markup Language – it’s the backbone that gives web pages their structure and meaning."
        },
        {
          "id": "action_9sjkuR60",
          "type": "spotlight",
          "elementId": "chart_1GZm7t9t"
        },
        {
          "id": "action_BuHudmh1",
          "type": "speech",
          "text": "Here’s a simple diagram showing the hierarchy: the document starts with <!DOCTYPE html>, then the <html> tag wraps everything, inside we have <head> for meta‑info and the <title>, and finally the <body> where all visible content lives."
        },
        {
          "id": "action_6n3uaXdy",
          "type": "laser",
          "elementId": "text_n4okCkXv"
        },
        {
          "id": "action_Ex7CoN0W",
          "type": "speech",
          "text": "Remember, every tag is written with angle brackets, like <tag>. Don’t worry if that feels new – you’ll get the hang of it quickly."
        },
        {
          "id": "action_R3pXyLcv",
          "type": "speech",
          "text": "That’s the core skeleton of any HTML page. Any questions before we move on to building our first page together?"
        }
      ],
      "createdAt": 1777564225465,
      "updatedAt": 1777564225465
    },
    {
      "id": "scene_MePVm3b1bc",
      "stageId": "ALVWX7b4Lx",
      "type": "interactive",
      "title": "Identify HTML Tags",
      "order": 3,
      "content": {
        "type": "interactive",
        "url": "",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Identify HTML Tags Playground</title>\n    <style>\n        body {font-family: Arial, sans-serif; margin:0; padding:0; display:flex; flex-direction:column; min-height:100vh;}\n        #container {flex:1; display:flex; flex-direction:column; padding:1rem; gap:1rem;}\n        #editor {border:1px solid #ccc; height:250px;}\n        #output {border:1px solid #ccc; padding:0.5rem; min-height:150px; background:#f9f9f9;}\n        #controls {display:flex; gap:0.5rem; flex-wrap:wrap;}\n        button {padding:0.5rem 1rem; font-size:1rem; cursor:pointer;}\n        #tests {margin-top:0.5rem;}\n        .test-pass {color:green;}\n        .test-fail {color:red;}\n        #hintBox {margin-top:0.5rem; padding:0.5rem; border:1px dashed #888; display:none; background:#fff8e1;}\n        @media (max-width:600px){\n            #editor, #output {height:auto; min-height:200px;}\n        }\n    </style>\n    <!-- CodeMirror 6 -->\n    <script type=\"module\">\n        import {EditorView, basicSetup} from \"https://cdn.jsdelivr.net/npm/@codemirror/basic-setup@0.19.1/+esm\";\n        import {html} from \"https://cdn.jsdelivr.net/npm/@codemirror/lang-html@0.19.6/+esm\";\n\n        window.initEditor = function(){\n            window.editor = new EditorView({\n                doc: `<!DOCTYPE html>\n<html>\n<head>\n    <title>My Page</title>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css\">\n<script src=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js\"></script>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    const katexOptions = {\n        delimiters: [\n            {left: '\\\\[', right: '\\\\]', display: true},\n            {left: '\\\\(', right: '\\\\)', display: false},\n            {left: '$$', right: '$$', display: true},\n            {left: '$', right: '$', display: false}\n        ],\n        throwOnError: false,\n        strict: false,\n        trust: true\n    };\n\n    let renderTimeout;\n    function safeRender() {\n        if (renderTimeout) clearTimeout(renderTimeout);\n        renderTimeout = setTimeout(() => {\n            renderMathInElement(document.body, katexOptions);\n        }, 100);\n    }\n\n    renderMathInElement(document.body, katexOptions);\n\n    const observer = new MutationObserver((mutations) => {\n        let shouldRender = false;\n        mutations.forEach((mutation) => {\n            if (mutation.target &&\n                mutation.target.className &&\n                typeof mutation.target.className === 'string' &&\n                mutation.target.className.includes('katex')) {\n                return;\n            }\n            shouldRender = true;\n        });\n\n        if (shouldRender) {\n            safeRender();\n        }\n    });\n\n    observer.observe(document.body, {\n        childList: true,\n        subtree: true,\n        characterData: true\n    });\n\n    setInterval(() => {\n        const text = document.body.innerText;\n        if (text.includes('\\\\(') || text.includes('$$')) {\n            safeRender();\n        }\n    }, 2000);\n});\n</script>\n</head>\n<body>\n    <h1>Hello World</h1>\n    <p>This is a paragraph.</p>\n</body>\n</html>`,\n                extensions: [basicSetup, html()],\n                parent: document.getElementById('editor')\n            });\n        };\n    </script>\n</head>\n<body>\n<div id=\"container\">\n    <h2>Identify HTML Tags Playground</h2>\n    <div id=\"editor\"></div>\n    <div id=\"controls\">\n        <button id=\"runBtn\">Run ▶️</button>\n        <button id=\"hintBtn\">Show Hint 💡</button>\n    </div>\n    <div id=\"hintBox\"></div>\n    <h3>Output</h3>\n    <iframe id=\"output\" sandbox=\"allow-same-origin\"></iframe>\n    <h3>Test Cases</h3>\n    <div id=\"tests\"></div>\n</div>\n\n<script>\n    // Configuration JSON\n    const widgetConfig = {\n        \"type\": \"code\",\n        \"language\": \"html\",\n        \"description\": \"Learners practice recognizing basic tags in a small HTML snippet.\",\n        \"starterCode\": \"<!DOCTYPE html>\\n<html>\\n<head>\\n    <title>My Page</title>\\n</head>\\n<body>\\n    <h1>Hello World</h1>\\n    <p>This is a paragraph.</p>\\n</body>\\n</html>\",\n        \"testCases\": [\n            {\"id\":\"t1\",\"description\":\"Contains <!DOCTYPE>\",\"check\":code=>code.includes(\"<!DOCTYPE\")},\n            {\"id\":\"t2\",\"description\":\"Contains <html>\",\"check\":code=>code.includes(\"<html>\")},\n            {\"id\":\"t3\",\"description\":\"Contains <head>\",\"check\":code=>code.includes(\"<head>\")},\n            {\"id\":\"t4\",\"description\":\"Contains <title>\",\"check\":code=>code.includes(\"<title>\")},\n            {\"id\":\"t5\",\"description\":\"Contains <body>\",\"check\":code=>code.includes(\"<body>\")},\n            {\"id\":\"t6\",\"description\":\"Contains <h1>\",\"check\":code=>code.includes(\"<h1>\")},\n            {\"id\":\"t7\",\"description\":\"Contains <p>\",\"check\":code=>code.includes(\"<p>\")}\n        ],\n        \"hints\": [\n            \"Take a look at the very first line – it declares the document type.\",\n            \"The root element of an HTML document is <html>.\",\n            \"Inside <head> you’ll find the <title> tag.\",\n            \"The visible part of the page lives inside <body>.\",\n            \"Headings use tags like <h1>.\",\n            \"Paragraphs are wrapped with <p>.\"\n        ],\n        \"solution\": \"<!DOCTYPE html>\\n<html>\\n<head>\\n    <title>My Page</title>\\n</head>\\n<body>\\n    <h1>Hello World</h1>\\n    <p>This is a paragraph.</p>\\n</body>\\n</html>\",\n        \"teacherActions\": [\n            {\"id\":\"act1\",\"type\":\"speech\",\"content\":\"Try implementing the solution\"}\n        ]\n    };\n\n    // Initialize editor after DOM load\n    window.addEventListener('DOMContentLoaded', () => {\n        initEditor();\n        document.getElementById('runBtn').addEventListener('click', runCode);\n        document.getElementById('hintBtn').addEventListener('click', showHint);\n        renderTests();\n    });\n\n    function runCode() {\n        const code = editor.state.doc.toString();\n        const iframe = document.getElementById('output');\n        iframe.srcdoc = code;\n        evaluateTests(code);\n    }\n\n    function evaluateTests(code) {\n        const testContainer = document.getElementById('tests');\n        testContainer.innerHTML = '';\n        widgetConfig.testCases.forEach(tc => {\n            const passed = tc.check(code);\n            const div = document.createElement('div');\n            div.textContent = `${tc.description}: ${passed ? 'PASS' : 'FAIL'}`;\n            div.className = passed ? 'test-pass' : 'test-fail';\n            testContainer.appendChild(div);\n        });\n    }\n\n    function renderTests() {\n        // Show placeholder before first run\n        const testContainer = document.getElementById('tests');\n        widgetConfig.testCases.forEach(tc => {\n            const div = document.createElement('div');\n            div.textContent = `${tc.description}: —`;\n            testContainer.appendChild(div);\n        });\n    }\n\n    let hintIndex = 0;\n    function showHint() {\n        if (hintIndex < widgetConfig.hints.length) {\n            const box = document.getElementById('hintBox');\n            box.style.display = 'block';\n            box.textContent = widgetConfig.hints[hintIndex];\n            hintIndex++;\n        } else {\n            alert('No more hints available.');\n        }\n    }\n</script>\n</body>\n</html>",
        "widgetType": "code",
        "teacherActions": [
          {
