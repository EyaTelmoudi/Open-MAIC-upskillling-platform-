              "top": 50,
              "width": 880,
              "height": 70,
              "content": "<p style=\"font-size:32px; text-align:center;\"><strong>HTML Basics &amp; Document Structure</strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333",
              "rotate": 0
