      "actions": [
        {
          "id": "action_1jLtoA-D",
          "type": "spotlight",
          "elementId": "text_whbDS0M6"
        },
        {
          "id": "action_rwupzCQA",
          "type": "speech",
          "text": "Good morning, everyone! I’m Ella, and I’m thrilled to welcome you to our web‑development adventure."
        },
        {
          "id": "action_AHaSJrLk",
          "type": "spotlight",
          "elementId": "text_uzcnqlZA"
        },
        {
          "id": "action__UyRcgwQ",
          "type": "speech",
          "text": "First, let’s look at what this course is all about. Our main goal is to help you build a simple web page using HTML, even if you’ve never written a line of code before."
        },
        {
          "id": "action_ifBpwYYx",
          "type": "laser",
          "elementId": "text_uzcnqlZA"
        },
        {
          "id": "action_p0BvvCVn",
          "type": "speech",
          "text": "We’ll start with the basics: document structure, headings, links, images, lists, tables, forms, and why semantic HTML matters."
        },
        {
          "id": "action_1Scg3vq4",
          "type": "laser",
          "elementId": "text_uzcnqlZA"
        },
        {
          "id": "action_UIgGbiOk",
          "type": "speech",
          "text": "The format is short, progressive lessons with quick quizzes and a hands‑on activity at the end, so you’ll get plenty of practice right away."
        },
        {
          "id": "action_sXTzZGd3",
          "type": "speech",
          "text": "That’s the roadmap for today—let’s jump in and start building something amazing together!"
        }
      ],
      "createdAt": 1777564170281,
      "updatedAt": 1777564170281
    },
