            {
              "id": "text_O_OK2enY",
              "type": "text",
              "left": 60,
              "top": 50,
              "width": 880,
              "height": 70,
              "content": "<p style=\"font-size:32px; text-align:center; color:#0f766e;\"><strong>OpenMAIC Storage Architecture</strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#0f766e",
              "rotate": 0
            },
            {
              "id": "text_2gOrYT_J",
              "type": "text",
              "left": 80,
              "top": 130,
              "width": 840,
              "height": 103,
              "content": "<p style=\"font-size:18px; color:#1f2937; line-height:1.55; text-align:left;\">• Disk module – persistent data storage</p><p style=\"font-size:18px; color:#1f2937; line-height:1.55; text-align:left;\">• Cache layer – fast read/write acceleration</p><p style=\"font-size:18px; color:#1f2937; line-height:1.55; text-align:left;\">• Metadata service – tracks objects and locations</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1f2937",
              "rotate": 0
            },
            {
              "id": "chart__VmA6He4",
              "type": "chart",
              "left": 100,
              "top": 260,
              "width": 800,
              "height": 300,
              "chartType": "bar",
              "data": {
                "labels": [
                  "Disk",
                  "Cache",
                  "Metadata"
                ],
                "legends": [
                  "Component"
                ],
                "series": [
                  [
                    1,
                    1,
                    1
                  ]
                ]
              },
              "themeColors": [
                "#5b9bd5",
                "#70ad47",
                "#ed7d31"
              ],
              "rotate": 0
            }
          ],
          "background": {
            "type": "gradient",
            "gradient": {
              "type": "linear",
              "colors": [
                {
                  "color": "#f8fffd",
                  "pos": 0
                },
                {
                  "color": "#eef6ff",
                  "pos": 100
                }
              ],
              "rotate": 135
