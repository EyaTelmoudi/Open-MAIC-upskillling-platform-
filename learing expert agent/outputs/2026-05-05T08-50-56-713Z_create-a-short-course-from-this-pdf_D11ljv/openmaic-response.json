              "top": 160,
              "width": 840,
              "height": 118,
              "content": "<p style=\"font-size:18px; color:#1f2937; line-height:1.55; text-align:left;\">• What is OpenMAIC?</p><p style=\"font-size:18px; color:#1f2937; line-height:1.55; text-align:left;\">• Why storage smoke tests matter</p><p style=\"font-size:18px; color:#1f2937; line-height:1.55; text-align:left;\">• Course agenda and learning goals</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1f2937",
