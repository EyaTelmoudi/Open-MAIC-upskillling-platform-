              "top": 50,
              "width": 880,
              "height": 70,
              "content": "<p style=\"font-size:32px; text-align:center; color:#0f766e;\"><strong>What Is a Smoke Test?</strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#0f766e",
              "rotate": 0
            },
            {
              "id": "shape_jKqs9Zhk",
              "type": "shape",
