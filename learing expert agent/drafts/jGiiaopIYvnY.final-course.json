              "top": 150,
              "left": 80,
              "type": "text",
              "width": 840,
              "height": 103,
              "rotate": 0,
              "content": "<p style=\"font-size:18px; color:#1f2937; line-height:1.55; text-align:left;\">• Cascading Style Sheets (CSS) – defines visual style</p><p style=\"font-size:18px; color:#1f2937; line-height:1.55; text-align:left;\">• Separates content (HTML) from presentation (CSS)</p><p style=\"font-size:18px; color:#1f2937; line-height:1.55; text-align:left;\">• Unstyled vs. styled page example</p>",
              "defaultColor": "#1f2937",
              "defaultFontName": "Microsoft YaHei"
            },
            {
              "id": "shape_K5n0kVRP",
              "top": 283,
              "fill": "#f0f4f8",
