      "title": "What Is CSS?",
      "actions": [
        {
          "id": "action_ughq4ASJ",
          "type": "spotlight",
          "title": "聚焦重点",
          "elementId": "text_DuL0nESt"
        },
        {
          "id": "action_OVLHPkfq",
          "text": "Definition of Cascading Style Sheets。Separation of content (HTML) and presentation (CSS)。Simple before‑and‑after examples of an unstyled vs. styled page。",
          "type": "speech",
          "title": "场景讲解"
        }
      ],
