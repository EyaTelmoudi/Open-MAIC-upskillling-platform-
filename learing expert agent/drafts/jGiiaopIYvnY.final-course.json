              "type": "text",
              "width": 840,
              "height": 64,
              "rotate": 0,
              "content": "<p>&amp;lt;!DOCTYPE html&amp;gt;</p><p>&amp;lt;html&amp;gt;</p><p>&amp;nbsp;&amp;nbsp;&amp;lt;head&amp;gt;&amp;lt;/head&amp;gt;</p><p>&amp;nbsp;&amp;nbsp;&amp;lt;body&amp;gt;Hello World&amp;lt;/body&amp;gt;</p><p>&amp;lt;/html&amp;gt;</p><p>/* CSS */</p><p>body { font-family: Arial; color: #333; }</p>",
