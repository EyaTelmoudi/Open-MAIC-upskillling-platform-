      "content": {
        "url": "",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Live HTML Playground</title>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <!-- CodeMirror -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.css\">\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/xml/xml.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/htmlmixed/htmlmixed.min.js\"></script>\n    <style>\n        body {font-family: Arial, sans-serif; margin:0; padding:0; display:flex; flex-direction:column; min-height:100vh;}\n        .container {flex:1; display:flex; flex-direction:column; padding:10px;}\n        .editor-preview {display:flex; flex:1; gap:10px; flex-wrap:wrap;}\n        .editor {flex:1 1 300px; min-height:250px;}\n        .preview {flex:1 1 300px; border:1px solid #ccc; padding:5px; overflow:auto; background:#fafafa;}\n        button {margin-top:5px; padding:5px 10px;}\n        .hints, .tests {margin-top:10px;}\n        .hint {cursor:pointer; color:#0066cc; margin-bottom:5px;}\n        .hint-content {display:none; margin-left:15px; color:#333;}\n        .test {margin-bottom:5px;}\n        .pass {color:green;}\n        .fail {color:red;}\n        @media (max-width:600px) {\n            .editor-preview {flex-direction:column;}\n        }\n    </style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css\">\n<script src=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js\"></script>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    const katexOptions = {\n        delimiters: [\n            {left: '\\\\[', right: '\\\\]', display: true},\n            {left: '\\\\(', right: '\\\\)', display: false},\n            {left: '$$', right: '$$', display: true},\n            {left: '$', right: '$', display: false}\n        ],\n        throwOnError: false,\n        strict: false,\n        trust: true\n    };\n\n    let renderTimeout;\n    function safeRender() {\n        if (renderTimeout) clearTimeout(renderTimeout);\n        renderTimeout = setTimeout(() => {\n            renderMathInElement(document.body, katexOptions);\n        }, 100);\n    }\n\n    renderMathInElement(document.body, katexOptions);\n\n    const observer = new MutationObserver((mutations) => {\n        let shouldRender = false;\n        mutations.forEach((mutation) => {\n            if (mutation.target &&\n                mutation.target.className &&\n                typeof mutation.target.className === 'string' &&\n                mutation.target.className.includes('katex')) {\n                return;\n            }\n            shouldRender = true;\n        });\n\n        if (shouldRender) {\n            safeRender();\n        }\n    });\n\n    observer.observe(document.body, {\n        childList: true,\n        subtree: true,\n        characterData: true\n    });\n\n    setInterval(() => {\n        const text = document.body.innerText;\n        if (text.includes('\\\\(') || text.includes('$$')) {\n            safeRender();\n        }\n    }, 2000);\n});\n</script>\n</head>\n<body>\n<div class=\"container\">\n    <h2>Live HTML Playground</h2>\n    <div class=\"editor-preview\">\n        <div class=\"editor\">\n            <textarea id=\"code-area\"><!DOCTYPE html>\n<html>\n<head>\n    <title>My Sample Page</title>\n</head>\n<body>\n    <h1>Hello World!</h1>\n    <p>This is a sample paragraph. Edit the HTML to experiment.</p>\n</body>\n</html></textarea>\n            <button id=\"run-btn\">Run ▶️</button>\n        </div>\n        <div class=\"preview\" id=\"preview-area\"></div>\n    </div>\n\n    <div class=\"hints\">\n        <h3>Hints</h3>\n        <div class=\"hint\" data-index=\"0\">How to add a heading</div>\n        <div class=\"hint-content\">Use &lt;h1&gt; to &lt;h6&gt; tags, e.g., &lt;h2&gt;My Heading&lt;/h2&gt;.</div>\n        <div class=\"hint\" data-index=\"1\">Creating a link</div>\n        <div class=\"hint-content\">Use &lt;a href=\"url\"&gt;link text&lt;/a&gt;.</div>\n        <div class=\"hint\" data-index=\"2\">Adding an image</div>\n        <div class=\"hint-content\">Use &lt;img src=\"path\" alt=\"description\"&gt;.</div>\n    </div>\n\n    <div class=\"tests\">\n        <h3>Test Cases</h3>\n        <div class=\"test\" data-id=\"t1\">Contains a &lt;h1&gt; element</div>\n        <div class=\"test\" data-id=\"t2\">Contains a &lt;p&gt; element</div>\n    </div>\n</div>\n\n<script>\n    // Widget configuration JSON (for reference)\n    const widgetConfig = {\n        \"type\":\"code\",\n        \"language\":\"html\",\n        \"description\":\"Edit HTML and see live preview.\",\n        \"starterCode\":\"<!DOCTYPE html>\\\\n<html>\\\\n<head>\\\\n    <title>My Sample Page</title>\\\\n</head>\\\\n<body>\\\\n    <h1>Hello World!</h1>\\\\n    <p>This is a sample paragraph. Edit the HTML to experiment.</p>\\\\n</body>\\\\n</html>\",\n        \"testCases\":[\n            {\"id\":\"t1\",\"description\":\"Contains a <h1> element\"},\n            {\"id\":\"t2\",\"description\":\"Contains a <p> element\"}\n        ],\n        \"hints\":[\n            \"How to add a heading\",\n            \"Creating a link\",\n            \"Adding an image\"\n        ]\n    };\n</script>\n\n<script>\n    // Initialize CodeMirror\n    const editor = CodeMirror.fromTextArea(document.getElementById('code-area'), {\n        mode: \"htmlmixed\",\n        lineNumbers: true,\n        lineWrapping: true,\n        theme: \"default\"\n    });\n\n    // Run button handler\n    document.getElementById('run-btn').addEventListener('click', () => {\n        const code = editor.getValue();\n        const preview = document.getElementById('preview-area');\n        preview.innerHTML = code;\n        runTests(code);\n    });\n\n    // Hint system\n    document.querySelectorAll('.hint').forEach(hintEl => {\n        hintEl.addEventListener('click', () => {\n            const idx = hintEl.getAttribute('data-index');\n            const content = hintEl.nextElementSibling;\n            content.style.display = content.style.display === 'block' ? 'none' : 'block';\n        });\n    });\n\n    // Simple test runner\n    function runTests(html) {\n        const parser = new DOMParser();\n        const doc = parser.parseFromString(html, 'text/html');\n        const tests = document.querySelectorAll('.test');\n        tests.forEach(testEl => {\n            const id = testEl.getAttribute('data-id');\n            let passed = false;\n            if (id === 't1') passed = !!doc.querySelector('h1');\n            if (id === 't2') passed = !!doc.querySelector('p');\n            testEl.className = 'test ' + (passed ? 'pass' : 'fail');\n            testEl.textContent = testEl.textContent.split(' - ')[0] + (passed ? ' - ✅ Passed' : ' - ❌ Failed');\n        });\n    }\n\n    // Initial run to display starter code\n    document.getElementById('run-btn').click();\n</script>\n</body>\n</html>",
        "type": "interactive",
