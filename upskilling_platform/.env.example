# PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql+pg8000://your_postgres_user:your_postgres_password@postgres:5432/your_database_name
DATABASE_URL_LOCAL=postgresql+pg8000://your_postgres_user:your_postgres_password@localhost:5433/your_database_name

# RabbitMQ
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@rabbitmq:5672/

# MinIO
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_SECURE=false

# Service Ports
GATEWAY_PORT=8000
IDENTITY_SERVICE_PORT=8001
LEARNING_SERVICE_PORT=8002
AGENTS_SERVICE_PORT=8003
NOTIFICATIONS_SERVICE_PORT=8004

# Application
ENVIRONMENT=development
LOG_LEVEL=debug
